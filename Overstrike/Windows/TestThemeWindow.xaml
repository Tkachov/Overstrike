<Window x:Class="Overstrike.Windows.TestThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Overstrike.Windows"
        mc:Ignorable="d"
        Title="Theme Test" Height="900" Width="900">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- LEFT COLUMN: Default Theme Controls -->
		<ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MainWindow_Background}">
			<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MainWindow_WindowTopBorder}">
				<StackPanel Margin="10,10,10,10">
					<!-- 1. Label -->
					<Label Content="Sample Label Element" Margin="0,0,0,10"/>

					<!-- 2. TextBlock -->
					<TextBlock Text="Sample TextBlock Element" Margin="0,0,0,10"/>
					<TextBlock Text="Sample TextBlock Element" Margin="0,0,0,10" Foreground="{DynamicResource MainWindow_ScriptWarningForeground}"/>
					<TextBlock Text="Sample TextBlock Element" Margin="0,0,0,10" Foreground="{DynamicResource MainWindow_SettingsGlobalDescriptionForeground}"/>

					<!-- 3. TextBox -->
					<TextBox Text="Sample TextBox text..." Padding="6,4" Margin="0,0,0,10"/>

					<!-- 4. ComboBox -->
					<ComboBox SelectedIndex="0" Margin="0,0,0,10">
						<ComboBoxItem Content="Option 1" />
						<ComboBoxItem Content="Option 2" />
						<ComboBoxItem Content="Option 3" />
					</ComboBox>

					<!-- 5. Button (Normal & Disabled) -->
					<Button Content="Normal Button" Margin="0,0,0,5"/>
					<Button Content="Disabled Button" IsEnabled="False" Margin="0,0,0,10"/>

					<!-- 6. CheckBox (Normal & Disabled) -->
					<CheckBox Content="Normal CheckBox" Margin="0,0,0,5"/>
					<CheckBox Content="Disabled CheckBox" IsEnabled="False" Margin="0,0,0,10"/>
					<CheckBox Content="Normal CheckBox" IsChecked="True" Margin="0,0,0,5"/>
					<CheckBox Content="Disabled CheckBox" IsChecked="True" IsEnabled="False" Margin="0,0,0,10"/>

					<!-- 7. TabControl & TabItem -->
					<TabControl Height="90" Margin="0,0,0,10">
						<TabItem Header="Tab One">
							<TextBlock Text="Content inside Tab One." Margin="5"/>
						</TabItem>
						<TabItem Header="Tab Two">
							<TextBlock Text="Content inside Tab Two." Margin="5"/>
						</TabItem>
					</TabControl>

					<!-- 8. Expander -->
					<Expander Header="Click to Expand" Margin="0,0,0,10">
						<TextBlock Text="Hidden content revealed inside the Expander." Margin="5"/>
					</Expander>
					<Expander Header="Click to Expand" IsExpanded="True" Margin="0,0,0,10">
						<TextBlock Text="Hidden content revealed inside the Expander." Margin="5"/>
					</Expander>

					<!-- 9. ScrollViewer (Working & Disabled Scrollbar variants) -->
					<TextBlock Text="ScrollViewer (Active Scrollbar):" FontSize="11" Margin="0,0,0,2"/>
					<ScrollViewer Height="80" VerticalScrollBarVisibility="Visible" Margin="0,0,0,10">
						<TextBlock Text="Line 1: Scrollable content here...&#x0a;Line 2: Keep scrolling down...&#x0a;Line 3: More text items...&#x0a;Line 4: End of content line.&#x0a;Line 5&#x0a;Line 6&#x0a;Line 7&#x0a;Line 8&#x0a;Line 9" />
					</ScrollViewer>

					<TextBlock Text="ScrollViewer (Disabled):" FontSize="11" Margin="0,0,0,2"/>
					<ScrollViewer Height="80" VerticalScrollBarVisibility="Visible" Margin="0,0,0,10">
						<TextBlock Text="Line 1: Disabled scroll content...&#x0a;Line 2: Locked text state...&#x0a;Line 3: More text items...&#x0a;Line 4: End of content line." />
					</ScrollViewer>
				</StackPanel>
			</Border>
		</ScrollViewer>

		<!-- RIGHT COLUMN: Dark Theme Controls (Scoped via Resources) -->
		<ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MainWindow_Background}" x:Name="RightColumn">
			<ScrollViewer.Resources>
				<ResourceDictionary>
					<ResourceDictionary.MergedDictionaries>
						<ResourceDictionary Source="../Themes/Dark/Theme.xaml" />
					</ResourceDictionary.MergedDictionaries>
				</ResourceDictionary>

			</ScrollViewer.Resources>

			<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MainWindow_WindowTopBorder}">
				<StackPanel Margin="10,10,10,10">
					<!-- 1. Label -->
					<Label Content="Sample Label Element" Margin="0,0,0,10"/>

					<!-- 2. TextBlock -->
					<TextBlock Text="Sample TextBlock Element" Margin="0,0,0,10"/>
					<TextBlock Text="Sample TextBlock Element" Margin="0,0,0,10" Foreground="{DynamicResource MainWindow_ScriptWarningForeground}"/>
					<TextBlock Text="Sample TextBlock Element" Margin="0,0,0,10" Foreground="{DynamicResource MainWindow_SettingsGlobalDescriptionForeground}"/>

					<!-- 3. TextBox -->
					<TextBox Text="Sample TextBox text..." Padding="6,4" Margin="0,0,0,10"/>

					<!-- 4. ComboBox -->
					<ComboBox SelectedIndex="0" Margin="0,0,0,10">
						<ComboBoxItem Content="Option 1" />
						<ComboBoxItem Content="Option 2" />
						<ComboBoxItem Content="Option 3" />
					</ComboBox>

					<!-- 5. Button (Normal & Disabled) -->
					<Button Content="Normal Button" Margin="0,0,0,5"/>
					<Button Content="Disabled Button" IsEnabled="False" Margin="0,0,0,10"/>

					<!-- 6. CheckBox (Normal & Disabled) -->
					<CheckBox Content="Normal CheckBox" Margin="0,0,0,5"/>
					<CheckBox Content="Disabled CheckBox" IsEnabled="False" Margin="0,0,0,10"/>
					<CheckBox Content="Normal CheckBox" IsChecked="True" Margin="0,0,0,5"/>
					<CheckBox Content="Disabled CheckBox" IsChecked="True" IsEnabled="False" Margin="0,0,0,10"/>

					<!-- 7. TabControl & TabItem -->
					<TabControl Height="90" Margin="0,0,0,10">
						<TabItem Header="Tab One">
							<TextBlock Text="Content inside Tab One." Margin="5"/>
						</TabItem>
						<TabItem Header="Tab Two">
							<TextBlock Text="Content inside Tab Two." Margin="5"/>
						</TabItem>
					</TabControl>

					<!-- 8. Expander -->
					<Expander Header="Click to Expand" Margin="0,0,0,10">
						<TextBlock Text="Hidden content revealed inside the Expander." Margin="5"/>
					</Expander>
					<Expander Header="Click to Expand" IsExpanded="True" Margin="0,0,0,10">
						<TextBlock Text="Hidden content revealed inside the Expander." Margin="5"/>
					</Expander>

					<!-- 9. ScrollViewer (Working & Disabled Scrollbar variants) -->
					<TextBlock Text="ScrollViewer (Active Scrollbar):" FontSize="11" Margin="0,0,0,2"/>
					<ScrollViewer Height="80" VerticalScrollBarVisibility="Visible" Margin="0,0,0,10">
						<TextBlock Text="Line 1: Scrollable content here...&#x0a;Line 2: Keep scrolling down...&#x0a;Line 3: More text items...&#x0a;Line 4: End of content line.&#x0a;Line 5&#x0a;Line 6&#x0a;Line 7&#x0a;Line 8&#x0a;Line 9" />
					</ScrollViewer>

					<TextBlock Text="ScrollViewer (Disabled):" FontSize="11" Margin="0,0,0,2"/>
					<ScrollViewer Height="80" VerticalScrollBarVisibility="Visible" Margin="0,0,0,10">
						<TextBlock Text="Line 1: Disabled scroll content...&#x0a;Line 2: Locked text state...&#x0a;Line 3: More text items...&#x0a;Line 4: End of content line." />
					</ScrollViewer>
				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</Window>
