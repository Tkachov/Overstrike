	<SolidColorBrush x:Key="Item.MouseOver.Background" Color="{Binding Color, Source={StaticResource s_itemBackgroundHover}}" />
	<SolidColorBrush x:Key="Item.MouseOver.Border" Color="{Binding Color, Source={StaticResource s_itemBorderHover}}" />
	<SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="{Binding Color, Source={StaticResource s_itemBackgroundInactive}}" />
	<SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="{Binding Color, Source={StaticResource s_itemBorderInactive}}" />
	<SolidColorBrush x:Key="Item.SelectedActive.Background" Color="{Binding Color, Source={StaticResource s_itemBackgroundActive}}" />
	<SolidColorBrush x:Key="Item.SelectedActive.Border" Color="{Binding Color, Source={StaticResource s_activeBorder}}" />

	<Style TargetType="{x:Type ListViewItem}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Padding" Value="4,1"/>
		<Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
		<Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
