<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="clr-namespace:Overstrike">
	
	<!-- theme colors, used statically here and are not used anywhere directly; in your theme, define your own instead of redefining these -->

	<Color x:Key="_background">#FFF</Color>
	<Color x:Key="_overlayBackground">#000</Color>
	<Color x:Key="_lightBackground">#F6F6F6</Color>
	<Color x:Key="_mutedBackground">#EEE</Color>

	<Color x:Key="_windowTopBorder">#EEE</Color>
	<Color x:Key="_border">#CCC</Color>
	<Color x:Key="_lightBorder">#AAA</Color>
	
	<Color x:Key="_grayText">#666</Color>
	<Color x:Key="_mutedText">#969696</Color>
	<Color x:Key="_lightText">#AAA</Color>
	<Color x:Key="_lighterText">#CCC</Color>
	<Color x:Key="_warningText">#F04</Color>

	<SolidColorBrush x:Key="_grayTextBrush" Color="{StaticResource _grayText}" />
	<SolidColorBrush x:Key="_mutedTextBrush" Color="{StaticResource _mutedText}" />
	<SolidColorBrush x:Key="_warningTextBrush" Color="{StaticResource _warningText}" />

	<Color x:Key="_buttonHover">#EEE</Color>
	<Color x:Key="_buttonPress">#CCC</Color>

	<SolidColorBrush x:Key="_suitsMenuSideBackgroundBrush" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="_suitsMenuDividerBrush" Color="{StaticResource _border}" />
	<SolidColorBrush x:Key="_suitsMenuDividerBrush_MSM2" Color="#DDD" />
	<SolidColorBrush x:Key="_suitsMenuWarningTextBrush_MSM2" Color="{StaticResource _grayText}" />

	<SolidColorBrush x:Key="_suitsMenuBackgroundBrush_MSMR" Color="#034" />
	<SolidColorBrush x:Key="_suitsMenuListBackgroundBrush_MSMR" Color="#057" />
	<SolidColorBrush x:Key="_suitsMenuSlotBorderBrush_MSMR" Color="#00DDEE" />
	<SolidColorBrush x:Key="_suitsMenuListSelectionBackgroundBrush_MSMR" Color="#098AE4" />

	<SolidColorBrush x:Key="_suitsMenuBackgroundBrush_MM" Color="#070C1B" />
	<SolidColorBrush x:Key="_suitsMenuListBackgroundBrush_MM" Color="#0D1C2B" />
	<SolidColorBrush x:Key="_suitsMenuSlotBorderBrush_MM" Color="#0FF" />
	<SolidColorBrush x:Key="_suitsMenuListSelectionBackgroundBrush_MM" Color="{Binding Color, Source={StaticResource _suitsMenuListSelectionBackgroundBrush_MSMR}}" />

	<SolidColorBrush x:Key="_suitsMenuBackgroundBrush_MSM2" Color="#000B1F" />
	<SolidColorBrush x:Key="_suitsMenuListBackgroundBrush_MSM2" Color="#06132F" />
	<SolidColorBrush x:Key="_suitsMenuSlotBorderBrush_MSM2" Color="#61EFF0" />
