<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="clr-namespace:Overstrike">
	
	<!-- theme colors, used statically here and are not used anywhere directly; in your theme, define your own instead of redefining these -->

	<Color x:Key="_background">#FFF</Color>
	<Color x:Key="_overlayBackground">#000</Color>
	<Color x:Key="_lightBackground">#F6F6F6</Color>
	<Color x:Key="_mutedBackground">#EEE</Color>

	<Color x:Key="_windowTopBorder">#EEE</Color>
	<Color x:Key="_border">#CCC</Color>
	<Color x:Key="_lightBorder">#AAA</Color>
	
	<Color x:Key="_grayText">#666</Color>
	<Color x:Key="_mutedText">#969696</Color>
	<Color x:Key="_lightText">#AAA</Color>
	<Color x:Key="_lighterText">#CCC</Color>
	<Color x:Key="_warningText">#F04</Color>

	<SolidColorBrush x:Key="_grayTextBrush" Color="{StaticResource _grayText}" />
	<SolidColorBrush x:Key="_mutedTextBrush" Color="{StaticResource _mutedText}" />
	<SolidColorBrush x:Key="_warningTextBrush" Color="{StaticResource _warningText}" />

	<Color x:Key="_buttonHover">#EEE</Color>
	<Color x:Key="_buttonPress">#CCC</Color>

	<SolidColorBrush x:Key="_suitsMenuSideBackgroundBrush" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="_suitsMenuDividerBrush" Color="{StaticResource _border}" />
	<SolidColorBrush x:Key="_suitsMenuDividerBrush_MSM2" Color="#DDD" />
	<SolidColorBrush x:Key="_suitsMenuWarningTextBrush_MSM2" Color="{StaticResource _grayText}" />

	<SolidColorBrush x:Key="_suitsMenuBackgroundBrush_MSMR" Color="#034" />
	<SolidColorBrush x:Key="_suitsMenuListBackgroundBrush_MSMR" Color="#057" />
	<SolidColorBrush x:Key="_suitsMenuSlotBorderBrush_MSMR" Color="#00DDEE" />
	<SolidColorBrush x:Key="_suitsMenuListSelectionBackgroundBrush_MSMR" Color="#098AE4" />

	<SolidColorBrush x:Key="_suitsMenuBackgroundBrush_MM" Color="#070C1B" />
	<SolidColorBrush x:Key="_suitsMenuListBackgroundBrush_MM" Color="#0D1C2B" />
	<SolidColorBrush x:Key="_suitsMenuSlotBorderBrush_MM" Color="#0FF" />
	<SolidColorBrush x:Key="_suitsMenuListSelectionBackgroundBrush_MM" Color="{Binding Color, Source={StaticResource _suitsMenuListSelectionBackgroundBrush_MSMR}}" />

	<SolidColorBrush x:Key="_suitsMenuBackgroundBrush_MSM2" Color="#000B1F" />
	<SolidColorBrush x:Key="_suitsMenuListBackgroundBrush_MSM2" Color="#06132F" />
	<SolidColorBrush x:Key="_suitsMenuSlotBorderBrush_MSM2" Color="#61EFF0" />
	<SolidColorBrush x:Key="_suitsMenuListSelectionBackgroundBrush_MSM2" Color="{Binding Color, Source={StaticResource _suitsMenuSlotBorderBrush_MSM2}}" />

	<SolidColorBrush x:Key="_suitsMenuTabBrush_MSM2" Color="#032338" />
	<SolidColorBrush x:Key="_suitsMenuTabTextBrush_MSM2" Color="#CCC" />
	<SolidColorBrush x:Key="_suitsMenuTabHighlightTextBrush_MSM2" Color="#62F7F8" />
	<SolidColorBrush x:Key="_suitsMenuTabHighlightBorderBrush_MSM2" Color="#3CCCF7" />
	<SolidColorBrush x:Key="_suitsMenuTabSelectedBrush_MSM2" Color="#389ED5" />

	<!-- styles, brushes and bitmaps that should be redefined -->

	<Style x:Key="MutedText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource _mutedTextBrush}" />
	</Style>
	<Style x:Key="GrayText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource _grayTextBrush}" />
	</Style>
	<Style x:Key="WarningText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource _warningTextBrush}" />
	</Style>

	<Style x:Key="MSM2SuitsMenu_SuitLoadoutCombobox" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
		<Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
	</Style>
	<Style x:Key="MSM2SuitsMenu_SuitWebwingsCombobox" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
		<Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
	</Style>

	<SolidColorBrush x:Key="Controls_TextBoxPlaceholder" Color="{StaticResource _lightText}"/>

	<SolidColorBrush x:Key="MainWindow_Background" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="MainWindow_WindowTopBorder" Color="{StaticResource _windowTopBorder}" />
	<SolidColorBrush x:Key="MainWindow_IconButtonHoverBackground" Color="{StaticResource _buttonHover}" />
	<SolidColorBrush x:Key="MainWindow_IconButtonPressedBackground" Color="{StaticResource _buttonPress}" />
	<SolidColorBrush x:Key="MainWindow_OverlayBackground" Color="{StaticResource _overlayBackground}" Opacity=".75"/>
	<SolidColorBrush x:Key="MainWindow_OverlayPanelBackground" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="MainWindow_StatusMessageForeground" Color="{StaticResource _lightText}" />
	<SolidColorBrush x:Key="MainWindow_StatusMessageErrorForeground" Color="{StaticResource _warningText}" />

	<SolidColorBrush x:Key="FirstLaunch_Background" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="FirstLaunch_WindowTopBorder" Color="{StaticResource _windowTopBorder}" />
	<SolidColorBrush x:Key="FirstLaunch_ProfilesHeaderBackground" Color="{StaticResource _lightBackground}" />
	<SolidColorBrush x:Key="FirstLaunch_ProfilesHeaderForeground" Color="{StaticResource _grayText}" />
	<SolidColorBrush x:Key="FirstLaunch_ProfilesBorder" Color="{StaticResource _lightBorder}" />

	<SolidColorBrush x:Key="CreateProfile_Background" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="CreateProfile_WindowTopBorder" Color="{StaticResource _windowTopBorder}" />

	<SolidColorBrush x:Key="ModsDetectionSplash_Background" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="ModsDetectionSplash_TopBorder" Color="{StaticResource _border}" />
	<SolidColorBrush x:Key="ModsDetectionSplash_OperationForeground" Color="{StaticResource _grayText}" />

	<SolidColorBrush x:Key="ErrorLogWindow_Background" Color="{StaticResource _mutedBackground}" />

	<SolidColorBrush x:Key="ModularWizard_MainBackground" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="ModularWizard_Border" Color="{StaticResource _border}" />
	<SolidColorBrush x:Key="ModularWizard_FooterBackground" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="ModularWizard_NumberLabelForeground" Color="{StaticResource _lighterText}" />

	<SolidColorBrush x:Key="TocMismatchDialog_Background" Color="{StaticResource _background}" />
	<SolidColorBrush x:Key="TocMismatchDialog_WindowTopBorder" Color="{StaticResource _windowTopBorder}" />
	<SolidColorBrush x:Key="TocMismatchDialog_FooterForeground" Color="{StaticResource _grayText}" />

	<SolidColorBrush x:Key="MSMRSuitsMenu_SideBackground" Color="{Binding Color, Source={StaticResource _suitsMenuSideBackgroundBrush}}" />
	<SolidColorBrush x:Key="MSMRSuitsMenu_Divider" Color="{Binding Color, Source={StaticResource _suitsMenuDividerBrush}}" />
	<SolidColorBrush x:Key="MSMRSuitsMenu_Background" Color="{Binding Color, Source={StaticResource _suitsMenuBackgroundBrush_MSMR}}" />
	<SolidColorBrush x:Key="MSMRSuitsMenu_ListBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MSMR}}" />
	<SolidColorBrush x:Key="MSMRSuitsMenu_OuterBorder" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MSMR}}" />
	<SolidColorBrush x:Key="MSMRSuitsMenu_SlotBorder" Color="{Binding Color, Source={StaticResource _suitsMenuSlotBorderBrush_MSMR}}" />
	<SolidColorBrush x:Key="MSMRSuitsMenu_ListSelectionBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListSelectionBackgroundBrush_MSMR}}" />

	<SolidColorBrush x:Key="MMSuitsMenu_SideBackground" Color="{Binding Color, Source={StaticResource _suitsMenuSideBackgroundBrush}}" />
	<SolidColorBrush x:Key="MMSuitsMenu_Divider" Color="{Binding Color, Source={StaticResource _suitsMenuDividerBrush}}" />
	<SolidColorBrush x:Key="MMSuitsMenu_Background" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MM}}" />
	<SolidColorBrush x:Key="MMSuitsMenu_ListBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MM}}" />
	<SolidColorBrush x:Key="MMSuitsMenu_OuterBorder" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MM}}" />
	<SolidColorBrush x:Key="MMSuitsMenu_SlotBorder" Color="{Binding Color, Source={StaticResource _suitsMenuSlotBorderBrush_MM}}" />
	<SolidColorBrush x:Key="MMSuitsMenu_ListSelectionBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListSelectionBackgroundBrush_MM}}" />

	<SolidColorBrush x:Key="MSM2SuitsMenu_SideBackground" Color="{Binding Color, Source={StaticResource _suitsMenuSideBackgroundBrush}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_HeaderDivider" Color="{Binding Color, Source={StaticResource _suitsMenuDividerBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_FooterDivider" Color="{Binding Color, Source={StaticResource _suitsMenuDividerBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_SpiderArmsWarningForeground" Color="{Binding Color, Source={StaticResource _suitsMenuWarningTextBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_Background" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_ListBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_OuterBorder" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_SlotBorder" Color="{Binding Color, Source={StaticResource _suitsMenuSlotBorderBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_ListSelectionBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListSelectionBackgroundBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_TabStripBackground" Color="{Binding Color, Source={StaticResource _suitsMenuListBackgroundBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabBackground" Color="{Binding Color, Source={StaticResource _suitsMenuTabBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabForeground" Color="{Binding Color, Source={StaticResource _suitsMenuTabTextBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabBorder" Color="{Binding Color, Source={StaticResource _suitsMenuTabBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabHoverForeground" Color="{Binding Color, Source={StaticResource _suitsMenuTabHighlightTextBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabHoverBorder" Color="{Binding Color, Source={StaticResource _suitsMenuTabHighlightBorderBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabActiveBackground" Color="{Binding Color, Source={StaticResource _suitsMenuTabSelectedBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabActiveForeground" Color="{Binding Color, Source={StaticResource _suitsMenuTabHighlightTextBrush_MSM2}}" />
	<SolidColorBrush x:Key="MSM2SuitsMenu_CharacterTabActiveBorder" Color="{Binding Color, Source={StaticResource _suitsMenuTabHighlightBorderBrush_MSM2}}" />

