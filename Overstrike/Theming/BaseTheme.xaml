	<!-- colors -->

	<!-- base -->
	<Color x:Key="dark">#202024</Color> <!-- background, SuitsMenu_SideBackground -->
	<Color x:Key="light">#D9D9D9</Color> <!-- text -->
	<Color x:Key="danger">#D24</Color> <!-- redText -->
	<Color x:Key="bright">#39F</Color> <!-- borderFocused, listItemActiveBorder, TextBoxSelection, menuItemHoverBorder, SuitsMenu_Selection -->
	
	<!-- shades -->	
	<Color x:Key="dark-20">#101014</Color> <!-- SuitsMenu_Background -->
	<Color x:Key="dark-15">#17171E</Color> <!-- TextBoxBack, checkmarkBackground, exFill -->
	<Color x:Key="dark-10">#1A1A1E</Color> <!-- backgroundD, backgroundDisabled, ErrorLogWindow_Background, SuitsMenu_ListBackground -->
	<Color x:Key="dark-05">#1D1D21</Color> <!-- menuGutterBackground -->
	<Color x:Key="dark+05">#242428</Color> <!-- backgroundH -->
	<Color x:Key="dark+05+blue">#24344B</Color> <!-- ComboItemSelectedBackground, listItemActiveBackground, menuItemHoverBackground -->
	<Color x:Key="dark+10">#27272C</Color> <!-- buttonDisableBackground (scrollbar & first launch header back), actuallyButtonDisableBackground -->
	<Color x:Key="dark+15">#292930</Color> <!-- backgroundHover, listItemHoverBackground -->
	<Color x:Key="dark+20">#2B2B31</Color> <!-- borderDisabled -->	
	<Color x:Key="dark+25">#2E2E33</Color> <!-- buttonBackground (only used in tooltip), actuallyButtonBackground -->
	<Color x:Key="dark+30a">#303035</Color> <!-- border, SuitsMenu_Divider, borderD, buttonBorder (scrollbar), buttonDisableBorder (tooltip), actuallyButtonDisableBorder -->
	<Color x:Key="dark+30b">#303039</Color> <!-- backgroundDisabledDarker -->	
	<Color x:Key="dark+35a">#333338</Color> <!-- buttonHoverBackground (main, checkmark, expander), actuallyButtonHoverBackground -->
	<Color x:Key="dark+35b">#33333C</Color> <!-- ComboItemNoFocusBackground, listItemInactiveBackground -->
	<Color x:Key="dark+35c">#343439</Color> <!-- borderH -->
	<Color x:Key="dark+40">#38383D</Color> <!-- buttonPressBackground (main, expander), actuallyButtonPressBackground -->
	<Color x:Key="dark+45">#3B3B40</Color> <!-- borderHover, listItemHoverBorder -->
	<Color x:Key="dark+50">#42424E</Color> <!-- borderDisabledDarker -->
	<Color x:Key="dark+55">#47474C</Color> <!-- buttonHoverBorder (checkmark), actuallyButtonBorder -->
	<Color x:Key="dark+60">#4C4C51</Color> <!-- buttonPressBorder (scrollbar), actuallyButtonPressBorder -->
	<Color x:Key="dark+65">#505055</Color> <!-- exbuttonPressBorder -->
	<Color x:Key="dark+75a">#57575C</Color> <!-- actuallyButtonHoverBorder -->
	<Color x:Key="dark+75b">#58585D</Color> <!-- buttonPressBackground2 -->
	<Color x:Key="dark+80">#606066</Color> <!-- exbuttonBorder -->
	<Color x:Key="dark+85a">#666</Color> <!-- NumberLabelForeground -->
	<Color x:Key="dark+85b">#66666E</Color> <!-- textDisabled, buttonDisableText, actuallyButtonDisableText -->
	<Color x:Key="dark+85c">#666675</Color> <!-- listItemInactiveBorder, ComboItemNoFocusBorder -->
	<Color x:Key="dark+90">#6C6C70</Color> <!-- buttonPressBorder2 -->
	<Color x:Key="dark+95">#707077</Color> <!-- exborderHover -->
	
	<Color x:Key="light-60">#96969E</Color> <!-- mutedText, textD -->
	<Color x:Key="light-55">#99999C</Color> <!-- exborderDisabledDarker -->
	<Color x:Key="light-45">#A6A6AE</Color> <!-- grayText -->
	<Color x:Key="light+30">#F3F3F3</Color> <!-- textHover -->
	
	<!-- semantics -->
	<SolidColorBrush x:Key="s_background" Color="{StaticResource dark}" />
