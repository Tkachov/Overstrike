    <BitmapImage x:Key="banner_i30_logo2.png" UriSource="/Overstrike;component/Properties/Resources/banner_i30_logo2.png" />
    <BitmapImage x:Key="banner_i33_back.png" UriSource="/Overstrike;component/Properties/Resources/banner_i30_back.png" />
    <BitmapImage x:Key="banner_i33_logo.png" UriSource="/Overstrike;component/Properties/Resources/banner_i33_logo.png" />
    <BitmapImage x:Key="banner_i33_logo2.png" UriSource="/Overstrike;component/Properties/Resources/banner_i30_logo2.png" />
    <BitmapImage x:Key="banner_mm_back.png" UriSource="/Overstrike;component/Properties/Resources/banner_mm_back.png" />
    <BitmapImage x:Key="banner_mm_logo.png" UriSource="/Overstrike;component/Properties/Resources/banner_mm_logo.png" />
