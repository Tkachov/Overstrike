<local:SuitsMenuBase x:Class="Overstrike.Tabs.MSM2SuitsMenu"
			xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			xmlns:local="clr-namespace:Overstrike.Tabs"
			mc:Ignorable="d"
			d:DesignHeight="450" d:DesignWidth="1004">

	<UserControl.Resources>
		<ItemsPanelTemplate x:Key="ThumbnailListTemplate">
			<WrapPanel Orientation="Horizontal" />
		</ItemsPanelTemplate>
		
		<Style x:Key="SeparatorButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Margin" Value="0,0,0,0" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Height" Value="100" />
			<Setter Property="Width" Value="20" />
			<Setter Property="Content" Value="+"/>
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Name="border" BorderThickness="1" BorderBrush="Transparent" Background="Gray" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Opacity" Value="0.8" TargetName="border" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		
		<Style x:Key="CharacterTabStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Foreground" Value="#CCC" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Name="border" Background="#032338" BorderThickness="2,2,0,2" BorderBrush="#032338">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="BorderBrush" Value="#3CCCF7" TargetName="border" />
								<Setter Property="Foreground" Value="#62F7F8" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		
		<Style x:Key="CharacterTabActiveStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Foreground" Value="#62F7F8" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Name="border" Background="#389ED5" BorderThickness="2,2,0,2" BorderBrush="#3CCCF7">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		
		<Style TargetType="{x:Type ListViewItem}" x:Key="NotemanagerContainerStyle">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ListViewItem}">
						<Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="0" Background="{TemplateBinding Background}" Padding="0" SnapsToDevicePixels="true">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsSelected" Value="true">
								<Setter Property="Background" TargetName="Bd" Value="#61EFF0" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="false">
								<Setter Property="Background" TargetName="Bd" Value="#61EFF0" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>

			<Setter Property="IsSelected" Value="False" />
		</Style>
	</UserControl.Resources>

	<Border BorderThickness="0,1,0,0" BorderBrush="#06132F" Margin="-2,-1,-2,-2">
		<Grid Background="#000B1F">
		<Grid.ColumnDefinitions>
			<ColumnDefinition/>
			<ColumnDefinition Width="1004" />
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid HorizontalAlignment="Stretch" Grid.Column="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="710" />
				<ColumnDefinition Width="294" />
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="28" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				
				<Grid Grid.Row="0" Background="#000B1F">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Button x:Name="_PeterTabButton" Grid.Column="0" Content="PETER" Style="{StaticResource CharacterTabActiveStyle}" Click="PeterTabButton_Click" />
					<Button x:Name="_MilesTabButton" Grid.Column="1" Content="MILES" Style="{StaticResource CharacterTabStyle}" Click="MilesTabButton_Click" />
				</Grid>

				<ListView Grid.Row="1" BorderThickness="0" Margin="0,0,0,-1" VirtualizingStackPanel.VirtualizationMode="Recycling" x:Name="_SuitsSlots" Background="#06132F"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
					ItemsPanel="{StaticResource ThumbnailListTemplate}" ItemContainerStyle="{StaticResource NotemanagerContainerStyle}" AllowDrop="True" SelectionMode="Single" Padding="77,7,77,0" SelectionChanged="SuitsSlots_SelectionChanged" MouseLeftButtonDown="SuitsSlots_MouseLeftButtonDown" MouseMove="SuitsSlots_MouseMove" DragEnter="SuitsSlots_DragEnter" Drop="SuitsSlots_Drop" KeyUp="SuitsSlots_KeyUp">
					<ListView.Resources>
						<DataTemplate DataType="{x:Type local:SuitSlot}">
							<Border Margin="11,8,11,7">
								<Border Width="112" Height="153" BorderThickness="3,3,3,3" BorderBrush="#61EFF0">
									<Grid ClipToBounds="True">
										<Image Source="{Binding Icon}" VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="{Binding DisplayOpacity}" Stretch="Fill" Margin="-20,0,0,0" Width="149" Height="154" />
									</Grid>
								</Border>
							</Border>
						</DataTemplate>
					</ListView.Resources>
				</ListView>
			</Grid>

			<Grid Background="#FFF" HorizontalAlignment="Stretch" Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="34" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="34" />
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#DDD">
					<TextBlock x:Name="_SuitName" Text="SUIT NAME" Margin="9,0,5,0" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
				</Border>

				<Grid x:Name="_SuitInfo" Grid.Row="1">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,8,6,8">
						<StackPanel>
							<Expander IsExpanded="True">
								<Expander.Header>
									<TextBlock Text="SLOT" FontWeight="SemiBold" />
								</Expander.Header>
								<Border BorderThickness="1" BorderBrush="#AAA" Padding="8" Margin="0,5,0,8">
									<StackPanel>
										<TextBlock Text="Change which suit this slot acts as, including its appearance and abilities." TextWrapping="Wrap" Foreground="#666" FontSize="10.5" Margin="0,0,0,8" />

										<Grid Margin="0,0,0,8">
											<Label Content="Suit:" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="60" />
											<ComboBox x:Name="_SuitLoadoutComboBox" Margin="65,0,0,0" SelectionChanged="SuitLoadoutComboBox_SelectionChanged">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Name}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
										</Grid>

										<Grid Margin="0,0,0,8">
											<Label Content="Icon:" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="60" />
											<ComboBox x:Name="_SuitIconComboBox" Margin="65,0,0,0" SelectionChanged="SuitIconComboBox_SelectionChanged">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<Grid>
															<Image Source="{Binding Icon}" HorizontalAlignment="Left" Stretch="Fill" Width="16" Height="16" />
															<TextBlock Text="{Binding Name}" HorizontalAlignment="Left" Margin="23,0,0,0" />
														</Grid>
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
										</Grid>

										<CheckBox x:Name="_SuitStoryProgressionCheckBox" Margin="0,0,0,8" Checked="SuitStoryProgressionCheckBox_Changed" Unchecked="SuitStoryProgressionCheckBox_Changed">
											<TextBlock Text="Ignore Story Suit Progression" Margin="2,0,0,0" />
										</CheckBox>

										<Button x:Name="_ToggleSuitDeleteButton" Content="Delete" HorizontalAlignment="Left" MinWidth="70" Padding="10,2" Click="ToggleSuitDeleteButton_Click" />
									</StackPanel>
								</Border>
							</Expander>

							<Expander IsExpanded="True">
								<Expander.Header>
									<TextBlock Text="MODEL" FontWeight="SemiBold" />
								</Expander.Header>
								<Border BorderThickness="1" BorderBrush="#AAA" Padding="8" Margin="0,5,0,0">
									<StackPanel>
										<TextBlock x:Name="_ModelUnavailableMessage" TextWrapping="Wrap" Foreground="#666" FontSize="10.5" Visibility="Collapsed" />

										<StackPanel x:Name="_ChangeSuitModelSection">
											<TextBlock Text="Suit model" FontWeight="SemiBold" Margin="0,0,0,3" />
											<TextBlock Text="Use another suit's body while keeping this slot's name, icon and abilities." TextWrapping="Wrap" Foreground="#666" FontSize="10.5" Margin="0,0,0,6" />
											<ComboBox x:Name="_SuitForceModelComboBox" SelectionChanged="SuitForceModelComboBox_SelectionChanged">
												<ComboBox.ItemContainerStyle>
													<Style TargetType="{x:Type ComboBoxItem}">
														<Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
													</Style>
												</ComboBox.ItemContainerStyle>
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Name}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<CheckBox x:Name="_SuitForceMaskCheckBox" Margin="0,7,0,0" Checked="SuitForceMaskCheckBox_Changed" Unchecked="SuitForceMaskCheckBox_Changed">
												<TextBlock Text="Force this suit's mask in cutscenes" Margin="2,0,0,0" />
											</CheckBox>
										</StackPanel>

										<StackPanel x:Name="_SuitForceSpiderArmsPanel" Margin="0,12,0,0">
											<Border BorderThickness="0,1,0,0" BorderBrush="#DDD" Margin="0,0,0,10" />
											<TextBlock Text="Spider-Arms" FontWeight="SemiBold" Margin="0,0,0,6" />
											<ComboBox x:Name="_SuitForceSpiderArmsComboBox" SelectionChanged="SuitForceSpiderArmsComboBox_SelectionChanged">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Name}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<TextBlock x:Name="_SuitForceSpiderArmsRageWarning" Text="Spider-Arms changes do not apply during Rage Mode. They only appear while the Symbiote Suit slot is selected in-game." TextWrapping="Wrap" Foreground="#666" FontSize="10.5" Margin="0,5,0,0" Visibility="Collapsed" />
										</StackPanel>
									</StackPanel>
								</Border>
							</Expander>
						</StackPanel>
					</ScrollViewer>
				</Grid>

				<Border Grid.Row="2" Margin="6,0,6,0" Padding="0,7" BorderThickness="0,1,0,1" BorderBrush="#DDD">
					<CheckBox IsChecked="{Binding Path=MSM2SuitsMenuContent_ShowDeleted}" HorizontalAlignment="Left">
						<TextBlock Text="Show deleted" Margin="2,0,0,0" />
					</CheckBox>
				</Border>

				<Grid x:Name="_NotModified" Grid.Row="3" Margin="1,0,5,5" Visibility="Collapsed">
					<Label x:Name="_NotModifiedStatusLabel" Content="No unsaved changes" HorizontalAlignment="Left" Margin="0,0,0,-1" VerticalAlignment="Bottom" />
					<Button x:Name="_ResetButton" Content="Reset" HorizontalAlignment="Right" Margin="0,0,1,1" VerticalAlignment="Bottom" Width="120" Height="22" Click="ResetButtonClicked" />
				</Grid>

				<Grid x:Name="_Modified" Grid.Row="3" Margin="1,0,5,5">
					<Label Content="There are unsaved changes!" HorizontalAlignment="Left" Margin="0,0,0,-1" VerticalAlignment="Bottom" FontWeight="Bold" />
					<Button Content="Undo" HorizontalAlignment="Right" Margin="0,0,62,1" VerticalAlignment="Bottom" Width="55" Height="22" Click="UndoChangesButtonClicked" />
					<Button Content="Save" HorizontalAlignment="Right" Margin="0,0,1,1" VerticalAlignment="Bottom" Width="55" Height="22" Click="SaveChangesButtonClicked" />
				</Grid>
			</Grid>
		</Grid>
		</Grid>
	</Border>
</local:SuitsMenuBase>
