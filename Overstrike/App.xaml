<Application x:Class="Overstrike.App"
			xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
			xmlns:local="clr-namespace:Overstrike">
	<Application.Resources>
		<Color x:Key="ThemeTextPrimaryColor">#E7ECF6</Color>
		<Color x:Key="ThemeTextMutedColor">#A8B3C8</Color>
		<Color x:Key="ThemeInputBackgroundColor">#101622</Color>
		<Color x:Key="ThemeSelectionColor">#2D7ED4</Color>
		<Color x:Key="ThemeSelectionInactiveColor">#2E3B52</Color>

		<SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#141821" />
		<SolidColorBrush x:Key="ThemeSurfaceBackgroundBrush" Color="#1B2231" />
		<SolidColorBrush x:Key="ThemeSurfaceAltBackgroundBrush" Color="#20283A" />
		<SolidColorBrush x:Key="ThemeBorderBrush" Color="#2F3A4F" />
		<SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimaryColor}" />
		<SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ThemeTextMutedColor}" />
		<SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="{StaticResource ThemeInputBackgroundColor}" />
		<SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#3D4960" />
		<SolidColorBrush x:Key="ThemeButtonBackgroundBrush" Color="#2A3448" />
		<SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#35445E" />
		<SolidColorBrush x:Key="ThemeButtonPressedBrush" Color="#1F293B" />
		<SolidColorBrush x:Key="ThemeSelectionBrush" Color="{StaticResource ThemeSelectionColor}" />
		<SolidColorBrush x:Key="ThemeSelectionInactiveBrush" Color="{StaticResource ThemeSelectionInactiveColor}" />

		<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource ThemeSelectionColor}" />
		<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource ThemeTextPrimaryColor}" />
		<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource ThemeSelectionInactiveColor}" />
		<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource ThemeTextPrimaryColor}" />

		<Style TargetType="{x:Type Window}">
			<Setter Property="Background" Value="{DynamicResource ThemeWindowBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type TextBlock}">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type Label}">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type Button}">
			<Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style TargetType="{x:Type CheckBox}">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type TextBox}">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelectionBrush}" />
			<Setter Property="SelectionTextBrush" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type RichTextBox}">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelectionBrush}" />
			<Setter Property="SelectionTextBrush" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type PasswordBox}">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
		</Style>

		<Style TargetType="{x:Type ComboBox}">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
			<Setter Property="Resources">
				<Setter.Value>
					<ResourceDictionary>
						<SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource ThemeInputBackgroundColor}" />
						<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource ThemeInputBackgroundColor}" />
						<SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource ThemeTextPrimaryColor}" />
						<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource ThemeSelectionColor}" />
						<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource ThemeTextPrimaryColor}" />
						<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource ThemeSelectionInactiveColor}" />
						<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource ThemeTextPrimaryColor}" />
					</ResourceDictionary>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="{x:Type ComboBoxItem}">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBoxItem}">
						<Border x:Name="ComboBoxItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="4,2">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="ComboBoxItemBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ComboBoxItemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.65" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="ComboBoxItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeTextSecondaryBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsHighlighted" Value="True">
					<Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style TargetType="{x:Type ListView}">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type ListViewItem}">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle">
				<Setter.Value>
					<Style TargetType="{x:Type Control}">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate>
									<Rectangle Margin="1" Stroke="{DynamicResource ThemeTextSecondaryBrush}" StrokeThickness="1" StrokeDashArray="1 1" SnapsToDevicePixels="True" />
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
					<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
				</Trigger>
				<MultiTrigger>
					<MultiTrigger.Conditions>
						<Condition Property="IsSelected" Value="True" />
						<Condition Property="primitives:Selector.IsSelectionActive" Value="False" />
					</MultiTrigger.Conditions>
					<Setter Property="Background" Value="{DynamicResource ThemeSelectionInactiveBrush}" />
				</MultiTrigger>
			</Style.Triggers>
		</Style>

		<Style TargetType="{x:Type TabControl}">
			<Setter Property="Background" Value="{DynamicResource ThemeWindowBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
		</Style>

		<Style TargetType="{x:Type TabItem}">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>

		<Style TargetType="{x:Type Expander}">
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
		</Style>
	</Application.Resources>
</Application>
